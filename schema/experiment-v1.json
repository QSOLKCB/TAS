{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsolkcb.github.io/TAS/schema/experiment-v1.json",
  "title": "TAS Acoustic Field Experiment",
  "description": "Portable state and derived results from the non-clinical TAS v0.1 workbench.",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "application",
    "fingerprint",
    "simulation",
    "derived",
    "model",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "https://qsolkcb.github.io/TAS/schema/experiment-v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "application": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "TAS Acoustic Field Workbench" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^tas-[0-9a-f]{8}$"
    },
    "simulation": {
      "$ref": "#/$defs/simulation"
    },
    "derived": {
      "type": "object",
      "required": [
        "mode",
        "metrics",
        "elementPositionsMm",
        "elementPhasesRad",
        "elementDelaysUs",
        "sdmtConstants",
        "sdmtTissueBandAudit"
      ]
    },
    "model": {
      "type": "object",
      "required": ["dimensionality", "propagation", "boundary", "modeTarget", "audio"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "simulation": {
      "type": "object",
      "required": [
        "elements",
        "frequencyMHz",
        "apertureMm",
        "referencePressureMpa",
        "dutyCycle",
        "envelopeHz",
        "focusXmm",
        "focusZmm",
        "steeringDeg",
        "phaseLaw",
        "goldenStrength",
        "mediumOne",
        "mediumTwo",
        "interfaceDepthMm",
        "includeReflection",
        "modeRank",
        "fieldWidthMm",
        "fieldDepthMm",
        "gridWidth",
        "gridHeight"
      ],
      "properties": {
        "elements": { "type": "integer", "minimum": 4, "maximum": 64, "multipleOf": 2 },
        "frequencyMHz": { "type": "number", "minimum": 0.1, "maximum": 3 },
        "apertureMm": { "type": "number", "minimum": 20, "maximum": 140 },
        "referencePressureMpa": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "dutyCycle": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "envelopeHz": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "focusXmm": { "type": "number", "minimum": -55, "maximum": 55 },
        "focusZmm": { "type": "number", "minimum": 5, "maximum": 120 },
        "steeringDeg": { "type": "number", "minimum": -70, "maximum": 70 },
        "phaseLaw": { "enum": ["focus", "heterogeneous", "plane", "golden"] },
        "goldenStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "mediumOne": { "$ref": "#/$defs/material" },
        "mediumTwo": { "$ref": "#/$defs/material" },
        "interfaceDepthMm": { "type": "number", "minimum": 1, "maximum": 119 },
        "includeReflection": { "type": "boolean" },
        "modeRank": { "type": "integer", "minimum": 1, "maximum": 96 },
        "fieldWidthMm": { "type": "number", "minimum": 40, "maximum": 300 },
        "fieldDepthMm": { "type": "number", "minimum": 40, "maximum": 300 },
        "gridWidth": { "type": "integer", "minimum": 40, "maximum": 360 },
        "gridHeight": { "type": "integer", "minimum": 40, "maximum": 240 }
      },
      "additionalProperties": false
    },
    "material": {
      "enum": ["water", "soft", "fat", "muscle", "bone"]
    }
  }
}
